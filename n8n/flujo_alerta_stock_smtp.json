    },
    {
      "parameters": {
        "jsCode": "// Convierte la salida del script Python en un mensaje listo para enviar\nconst r = JSON.parse($input.first().json.stdout);\nconst filas = r.productos.map(p =>\n  `<tr><td>${p.codigo}</td><td>${p.nombre}</td><td>${p.categoria}</td>` +\n  `<td style=\"text-align:right\">${p.stock_actual}</td>` +\n  `<td style=\"text-align:right\">${p.stock_minimo}</td>` +\n  `<td style=\"text-align:right\"><b>${p.deficit}</b></td></tr>`).join('');\nconst html =\n  `<p>Hola Alejandro,</p>` +\n  `<p>El sistema de inventario detectó <b>${r.total_alertas}</b> producto(s) bajo su stock mínimo ` +\n  `(revisión del ${r.fecha_consulta}). Se necesitan <b>${r.deficit_total}</b> unidades para recuperar los mínimos.</p>` +\n  `<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\">` +\n  `<tr><th>Código</th><th>Producto</th><th>Categoría</th><th>Stock</th><th>Mínimo</th><th>Déficit</th></tr>` +\n  filas + `</table>` +\n  `<p>Ordenados por déficit: los primeros son los más urgentes de reponer.</p>` +\n  `<p>— Sistema de Inventario Eliko</p>`;\nreturn [{ json: {\n  fecha_consulta: r.fecha_consulta,\n  total_alertas: r.total_alertas,\n  deficit_total: r.deficit_total,\n  asunto: `[Eliko] ${r.total_alertas} producto(s) bajo stock mínimo`,\n  html\n}}];"
      },
      "id": "3dc44e1c-0df6-437d-a351-e35d2b37992a",
      "name": "Armar mensaje de alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
